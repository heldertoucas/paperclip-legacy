{
  "hooks": {
    "PreModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m dev.cli session bootstrap --agent Antigravity --format antigravity",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m dev.cli session bootstrap --agent Codex --format text",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m dev.core.owned_hook --harness codex",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
